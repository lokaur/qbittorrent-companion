{
    "manifest_version": 3,
    "name": "qBittorrent Companion",
    "description": "A lightweight browser companion for managing your qBittorrent servers, torrents and downloads.",
    "version": "1.1.0",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_title": "qBittorrent",
        "default_popup": "index.html"
    },
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
